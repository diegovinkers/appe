# Copiá este archivo como .env y completá los valores. Nunca subas el .env a git.

# URI de MongoDB Atlas (Database → Connect → Drivers; empieza con "mongodb+srv").
# La base se llama app-pedidos y la elige el código, no la URI.
MONGO_URI=

# Clave para firmar las sesiones: 32+ caracteres aleatorios. Para generar una:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=4000
NODE_ENV=development

# Orígenes del front que pueden llamar a la API, separados por coma.
CORS_ORIGIN=http://localhost:5173

# Cantidad de proxies delante del servidor (0 en local; 1 detrás de Render, Railway, Nginx...).
TRUST_PROXY=0

# Dirección del front: se usa para armar los links del menú, el QR y el seguimiento.
PUBLIC_WEB_URL=http://localhost:5173

# Nivel de logs: fatal, error, warn, info, debug o trace (por defecto, info).
# LOG_LEVEL=info

# Opcional. Imágenes (logo, portada, productos) con Cloudinary. Se copia de la consola
# de Cloudinary → Settings → API Keys → "API environment variable".
# Sin esto, la subida de imágenes responde 503 y el resto funciona igual.
# CLOUDINARY_URL=

# Opcional. Asistente con IA (Claude). La clave se crea en console.anthropic.com → API Keys.
# Sin esto, el asistente queda apagado y el resto funciona igual.
# ANTHROPIC_API_KEY=
# Modelo (por defecto claude-haiku-4-5-20251001, el más barato).
# AI_MODEL=

# Opcional. WhatsApp Business (Cloud API de Meta) para el asistente. Ver docs/whatsapp-bot.md.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# Una palabra secreta que inventás vos y cargás igual en Meta al configurar el webhook.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# Opcional. Audios de los clientes: "local" los pasa a texto en este servidor (gratis); "none", no.
# TRANSCRIPTION_PROVIDER=none
# Modelo para "local": onnx-community/whisper-base (76 MB, rápido; por defecto) u
# onnx-community/whisper-small (241 MB, entiende mejor con ruido, unas 3 veces más lento).
# WHISPER_MODEL=onnx-community/whisper-base

# Opcional. Contestar con nota de voz cuando el cliente manda audio (se activa por local en el
# panel): "local" genera la voz en este servidor (gratis; ~110 MB por idioma la primera vez).
# VOICE_PROVIDER=none
